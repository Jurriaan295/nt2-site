---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Nederlands leren op locatie | Kristina Tjalsma';
const description = 'Nederlands leren op locatie voor bedrijven en particulieren in Friesland en Nederland. NT2-lessen op maat, persoonlijke begeleiding door Kristina Tjalsma – gecertificeerd docent.';
---
<BaseLayout title={title} description={description}>

  <!-- HERO -->
  <section class="hero-new">
    <div class="container hero-new-grid">
      <div class="hero-new-text">
        <!-- Desktop eyebrow (ongewijzigd) -->
        <p class="eyebrow hero-eyebrow-desktop">NT2 cursus op locatie · Friesland &amp; Nederland</p>
        <!-- Mobiele eyebrow (alleen op mobiel zichtbaar) -->
        <div class="hero-eyebrow-mobile" aria-hidden="false">
          <span class="hero-label-top">Nederlands leren op locatie</span>
          <span class="hero-label-sub">Friesland &amp; Nederland</span>
          <div class="hero-divider" aria-hidden="true">
            <span class="hero-divider-line"></span>
            <span class="hero-divider-dot"></span>
            <span class="hero-divider-line"></span>
          </div>
        </div>
        <h1>
          <span class="h1-line1">Nederlands leren op</span>
          <span class="h1-line2">locatie, op maat</span>
        </h1>
        <!-- Desktop: bestaande zin -->
        <p class="lead hero-lead-desktop">Praktisch, persoonlijk en direct toepasbaar — voor bedrijven én particulieren.</p>
        <!-- Mobiel: pilletjes i.p.v. vinkjeslijst -->
        <ul class="hero-lead-mobile hero-pills">
          <li>Praktisch</li>
          <li>Persoonlijk</li>
          <li>Direct toepasbaar</li>
        </ul>
        <div class="btn-row hero-btn-row" style="margin-top: 2rem;">
          <a class="btn btn-primary btn-lg hero-btn-offerte" href="/offerte-aanvragen/">Offerte aanvragen</a>
          <a class="btn btn-ghost hero-btn-contact" href="/contact/">Neem contact op</a>
        </div>
        <ul class="trust-list">
          <li><span class="trust-icon">✓</span> Op locatie in Friesland &amp; heel Nederland</li>
          <li><span class="trust-icon">✓</span> Alle niveaus A0–C1, individueel of in groep</li>
          <li><span class="trust-icon">✓</span> Start binnen 1–4 weken na intake</li>
        </ul>
      </div>
      <div class="hero-new-image">
        <img
          src="/images/kristina.webp"
          alt="Nederlands leren op locatie in Friesland bij Kristina Tjalsma"
          class="hero-portrait"
          width="540"
          height="620"
        />
      </div>
    </div>
  </section>

  <!-- DOELGROEPEN -->
  <section class="section bg-soft doelgroepen-section">
    <div class="container">
      <p class="eyebrow text-center doelgroepen-eyebrow">Voor wie?</p>
      <h2 class="text-center doelgroepen-h2" style="margin-bottom: 2.5rem;">Nederlands leren op maat voor uw situatie</h2>
      <div class="grid grid-3">
        <article class="surface card card-hover card-accent-purple">
          <div class="card-body">
            <h3>Voor bedrijven</h3>
            <p>Incompany Nederlandse les voor anderstalige medewerkers in techniek, logistiek, zorg en productie. Gericht op communicatie, veiligheid en samenwerking op de werkvloer.</p>
            <a href="/nt2-voor-bedrijven/" class="card-link">Meer voor bedrijven →</a>
          </div>
        </article>

        <article class="surface card card-hover card-accent-purple particulieren-card">
          <div class="card-body">
            <h3>Voor particulieren</h3>
            <p>Persoonlijke begeleiding voor expats en anderstaligen die werken aan hun inburgering of Nederlands willen leren, op een tempo en locatie die bij hen past.</p>
            <a href="/nt2-voor-particulieren/" class="card-link">Meer voor particulieren →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- OVER KRISTINA -->
  <section class="section about-kristina-section">
    <div class="container grid grid-2 align-center">
      <div class="about-img-wrap">
        <img
          src="/images/kristina2.jpeg"
          alt="Kristina Tjalsma – docent Nederlandse les in Friesland, aan het werk"
          class="about-portrait"
          loading="lazy"
          width="480"
          height="720"
        />
      </div>
      <div>
        <p class="eyebrow about-eyebrow">Over de docent</p>
        <h2 class="about-h2">Kristina Tjalsma</h2>
        <p class="lead-dark">Docent Nederlandse les op locatie in Friesland en heel Nederland</p>
        <p>Ik geloof dat taal pas echt tot leven komt wanneer je die direct kunt gebruiken. Daarom geef ik les op locatie — bij bedrijven, instellingen of bij mensen thuis, met een aanpak die aansluit op de praktijk van de deelnemer.</p>
        <p>Met jarenlange ervaring in NT2-onderwijs begeleid ik anderstaligen van absolute beginner tot gevorderden, bijvoorbeeld:</p>
        <ul class="trust-list" style="margin: 0 0 1rem;">
          <li><span class="trust-icon">✓</span> Een medewerker die instructies op de werkvloer moet begrijpen</li>
          <li><span class="trust-icon">✓</span> Een expat die zich wil inburgeren in Leeuwarden</li>
          <li><span class="trust-icon">✓</span> Een organisatie die investeert in de taalontwikkeling van haar team</li>
        </ul>

        <ul class="check-list about-check-list" style="margin-top: 1.25rem;">
          <li>Gecertificeerd NT2-docent</li>
          <li>Actief in Friesland, Leeuwarden, Drachten, Sneek, Heerenveen en heel Nederland</li>
          <li>Persoonlijke intake en maatwerk lesplan</li>
        </ul>
        <div class="btn-row about-btn-row" style="margin-top: 1.75rem;">
          <a class="btn btn-primary about-offerte-btn" href="/offerte-aanvragen/">Offerte aanvragen</a>
          <a class="btn btn-secondary howworks-desktop" href="/nt2-voor-bedrijven/">Meer voor bedrijven</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="section-tight bg-soft reviews-section">
    <div class="container">
      <p class="eyebrow text-center">Ervaringen</p>
      <h2 class="text-center reviews-h2">Wat cursisten zeggen</h2>
      <p class="text-center reviews-rating"><span class="reviews-stars" aria-hidden="true">★★★★☆</span> 4,3 sterren op <a href="https://www.google.com/maps/place/TaalPartner/@53.0521468,5.5767928,17z/data=!4m8!3m7!1s0x8dc63645a062dad5:0x6472a0da78d84b1a!8m2!3d53.0521468!4d5.5767928!9m1!1b1!16s%2Fg%2F11z69ntvdr" target="_blank" rel="noopener">Google</a></p>

      <div class="review-slider-wrap">
        <div class="review-slider" id="reviewSlider">
          <!-- Viewport: knipt alleen de track af, niet de pijltjes -->
          <div class="review-viewport">
            <!-- Track met reviews — echte Google-reviews, voeg hier makkelijk nieuwe toe -->
            <div class="review-track" id="reviewTrack">
              <div class="review-slide">
                <p class="review-stars-mini" aria-hidden="true">★★★★★</p>
                <p class="review-text">Ik vond de lessen bij Kristina erg leuk en leerzaam. Ze legt alles duidelijk uit en geeft veel zelfvertrouwen.</p>
                <p class="review-name">Emma Schneider</p>
              </div>
              <div class="review-slide">
                <p class="review-stars-mini" aria-hidden="true">★★★★☆</p>
                <p class="review-text">Geweldige lessen!</p>
                <p class="review-name">Isabella Harris</p>
              </div>
              <div class="review-slide">
                <p class="review-stars-mini" aria-hidden="true">★★★★☆</p>
                <p class="review-text">De lessen waren leuk en leerzaam.</p>
                <p class="review-name">Олена Коваленко</p>
              </div>
            </div>
          </div>

          <!-- Navigatiepijlen (alleen mobiel) -->
          <button class="review-arrow review-prev" id="reviewPrev" aria-label="Vorige review">&#8249;</button>
          <button class="review-arrow review-next" id="reviewNext" aria-label="Volgende review">&#8250;</button>

          <!-- Dots (alleen mobiel) -->
          <div class="review-dots" id="reviewDots">
            <span class="review-dot" data-index="0"></span>
            <span class="review-dot" data-index="1"></span>
            <span class="review-dot" data-index="2"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KPI STRIP -->
  <section class="section-tight kpi-section">
    <div class="container surface kpi-strip">
      <div class="kpi">
        <div class="bedrijven-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <span class="muted">Ideale groepsgrootte</span>
        <strong>4–12</strong>
      </div>
      <div class="kpi-divider"></div>
      <div class="kpi">
        <div class="bedrijven-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        </div>
        <span class="muted">Gemiddelde opstarttijd</span>
        <strong>1–4 weken</strong>
      </div>
      <div class="kpi-divider"></div>
      <div class="kpi">
        <div class="bedrijven-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        </div>
        <span class="muted">Alle niveaus</span>
        <strong>A0–C1</strong>
      </div>
      <div class="kpi-divider"></div>
      <div class="kpi">
        <div class="bedrijven-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <span class="muted">Werkgebied</span>
        <strong>Friesland &amp; NL</strong>
      </div>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section bg-soft">
    <div class="container">
      <p class="eyebrow text-center">Werkwijze</p>
      <h2 class="text-center" style="margin-bottom: 2.5rem;">Zo verloopt een traject</h2>
      <div class="grid grid-2">
        <div class="surface card step-card">
          <div class="step-icon-wrap">
            <div class="bedrijven-icon step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <span class="step-badge">1</span>
          </div>
          <h3>Kennismaking en intake</h3>
          <p style="margin-bottom: 0;">We bespreken de doelgroep, werksituatie, leerdoelen en gewenste planning. Vrijblijvend en helder.</p>
        </div>
        <div class="surface card step-card">
          <div class="step-icon-wrap">
            <div class="bedrijven-icon step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <span class="step-badge">2</span>
          </div>
          <h3>Niveau bepalen</h3>
          <p style="margin-bottom: 0;">Met een korte intake of taaltoets wordt duidelijk welk startniveau en welke aanpak het best passend zijn.</p>
        </div>
        <div class="surface card step-card">
          <div class="step-icon-wrap">
            <div class="bedrijven-icon step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <span class="step-badge">3</span>
          </div>
          <h3>Lesplan op maat</h3>
          <p style="margin-bottom: 0;">De lessen worden afgestemd op branche, werkomgeving en de dagelijkse situatie van de deelnemers.</p>
        </div>
        <div class="surface card step-card">
          <div class="step-icon-wrap">
            <div class="bedrijven-icon step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
            </div>
            <span class="step-badge">4</span>
          </div>
          <h3>Start en evaluatie</h3>
          <p style="margin-bottom: 0;">Tijdens het traject volgen we de voortgang met oefeningen, evaluaties en gerichte feedback.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTATEN -->
  <section class="section">
    <div class="container">
      <div class="resultaten-panel">
        <p class="eyebrow resultaten-eyebrow text-center">Resultaten</p>
        <h2 class="resultaten-h2 text-center">Resultaten van mijn cursisten</h2>
        <p class="resultaten-intro">Ik begeleid mijn cursisten stap voor stap vooruit — op de werkvloer, in het dagelijks leven en in hun zelfvertrouwen. Veel deelnemers behalen na hun traject een certificaat op het officieel erkende ERK-niveau (A1 t/m B2).</p>
        <ul class="check-list resultaten-check-list resultaten-check-list-center">
          <li>Aantoonbare voortgang per ERK-niveau</li>
          <li>Evaluatiemomenten tijdens en na het traject</li>
          <li>Certificaat op aanvraag mogelijk</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRIJS + STARTEN -->
  <section class="section-tight bg-soft">
    <div class="container grid grid-2">
      <div class="surface card">
        <p class="eyebrow prijs-eyebrow">Prijsindicatie</p>
        <h2 class="prijs-h2">Wat kost Nederlands leren op locatie?</h2>
        <p style="margin-bottom: 0;">De kosten zijn afhankelijk van het aantal deelnemers en de duur van het traject. Op basis daarvan maak ik een passend voorstel dat aansluit bij jullie wensen en doelen.</p>
      </div>
      <div class="surface card card-accent">
        <p class="eyebrow snel-eyebrow">Snel schakelen</p>
        <h2 class="snel-h2">Klaar om te starten?</h2>
        <p>In de meeste gevallen kan een traject binnen 1 tot 4 weken starten. Na een korte inventarisatie plannen we een intake en maken we een passend lesprogramma.</p>
        <div class="btn-row snel-btn-row">
          <a class="btn btn-primary btn-lg snel-offerte-btn" href="/offerte-aanvragen/">Offerte aanvragen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ PREVIEW -->
  <section class="section">
    <div class="container">
      <p class="eyebrow text-center">Veelgestelde vragen</p>
      <h2 class="text-center" style="margin-bottom: 2rem;">Korte antwoorden</h2>
      <div class="grid grid-2">
        <article class="surface faq-item">
          <h3>Geef je les op onze locatie?</h3>
          <p>Ja, ik geef Nederlandse les op locatie bij bedrijven in Friesland en in de rest van Nederland.</p>
        </article>
        <article class="surface faq-item">
          <h3>Is maatwerk mogelijk?</h3>
          <p>Ja. De lessen worden afgestemd op niveau, branche, dagelijkse werkzaamheden en leerdoelen.</p>
        </article>
        <article class="surface faq-item">
          <h3>Voor welk niveau?</h3>
          <p>Van beginners A0/A1 tot gevorderden B2/C1. Een intake helpt om het juiste niveau te bepalen.</p>
        </article>
        <article class="surface faq-item">
          <h3>Hoe groot zijn de groepen?</h3>
          <p>De ideale groepsgrootte ligt tussen 4 en 12 deelnemers, maar individuele lessen zijn ook mogelijk. Grotere groepen kunnen in overleg ook worden georganiseerd.</p>
        </article>
      </div>
      <p style="margin-top: 1.5rem; text-align: center;"><a href="/faq/">Bekijk alle veelgestelde vragen →</a></p>
    </div>
  </section>

  <!-- AFSLUITENDE CTA -->
  <section class="section-tight">
    <div class="container surface cta-strip cta-strip-strong">
      <div class="cta-text-block">
        <h2 class="cta-final-h2">Op zoek naar Nederlands leren op locatie?</h2>
        <p class="muted cta-final-p" style="margin-bottom: 0;">Ik denk graag mee over een traject dat past bij jouw organisatie of situatie. Reactie binnen 24 uur.</p>
      </div>
      <div class="btn-row cta-final-btn-row">
        <a class="btn btn-primary" href="/offerte-aanvragen/">Vraag een offerte aan</a>
        <a class="btn btn-ghost" href="/contact/">Neem contact op</a>
      </div>
    </div>
  </section>


<script>
  // ── Review Slider ──────────────────────────────────────────────
  const track   = document.getElementById('reviewTrack');
  const dots    = document.querySelectorAll('.review-dot');
  const prev    = document.getElementById('reviewPrev');
  const next    = document.getElementById('reviewNext');

  // Op desktop staan de reviews als statische kaarten naast elkaar (grid) —
  // de schuif-logica is alleen nodig voor de mobiele slider.
  if (track && window.matchMedia('(max-width: 900px)').matches) {
    const slides = track.querySelectorAll('.review-slide');
    let current  = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      current = (index + slides.length) % slides.length;
      (track as HTMLElement).style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function startAuto() {
      timer = setInterval(() => goTo(current + 1), 4000);
    }

    function resetAuto() {
      clearInterval(timer);
      startAuto();
    }

    // Initieel: eerste dot actief
    goTo(0);
    startAuto();

    prev?.addEventListener('click', () => { goTo(current - 1); resetAuto(); });
    next?.addEventListener('click', () => { goTo(current + 1); resetAuto(); });

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const idx = parseInt((dot as HTMLElement).dataset.index ?? '0');
        goTo(idx);
        resetAuto();
      });
    });
  }
</script>

</BaseLayout>
