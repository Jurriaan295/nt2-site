---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://taaldiewerkt.nl/' },
    { '@type': 'ListItem', position: 2, name: 'Voor bedrijven', item: 'https://taaldiewerkt.nl/nt2-voor-bedrijven/' },
  ],
};
---
<BaseLayout title="Incompany Nederlandse les op de werkvloer | Voor bedrijven" description="Incompany Nederlandse les op locatie voor bedrijven in Friesland en Nederland. Taaltraining voor anderstalige medewerkers, direct toepasbaar op de werkvloer.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <svg width="0" height="0" style="position:absolute;">
    <defs>
      <clipPath id="heroBlobClip" clipPathUnits="objectBoundingBox">
        <path d="M0.5,0.02 C0.75,0.0 0.95,0.12 0.98,0.38 C1.01,0.6 0.94,0.72 0.86,0.82 C0.76,0.95 0.6,1.02 0.42,0.98 C0.24,0.94 0.08,0.86 0.03,0.66 C-0.02,0.46 0.05,0.28 0.18,0.15 C0.28,0.05 0.38,0.03 0.5,0.02 Z"/>
      </clipPath>
    </defs>
  </svg>

  <div class="pg">

    <div class="hero">
      <div class="txt">
        <span class="eyebrow">Voor bedrijven</span>
        <h1>Nederlands leren op de werkvloer, samen groeien</h1>
        <p class="lead">Wanneer uw team zich zeker voelt in het Nederlands, groeit het mee — in begrip, in samenwerking, in zelfvertrouwen. Met incompany les op locatie maak ik van de werkvloer het klaslokaal.</p>
      </div>
      <div class="photo">
        <div class="blob-shape">
          <svg viewBox="0 0 300 340" aria-hidden="true">
            <path d="M150,7 C225,0 285,36 294,114 C303,180 282,216 258,246 C228,285 180,306 126,294 C72,282 24,258 9,198 C-6,138 15,84 54,45 C84,15 114,9 150,7 Z" fill="#e8c9a8"/>
          </svg>
          <img src="/images/kristina.webp" alt="Kristina Tjalsma, docent Nederlands leren op de werkvloer" width="540" height="620" />
          <div class="warm-overlay"></div>
        </div>
      </div>
    </div>

    <div class="kw-strip">
      <div class="kw-tags">
        <span>Nederlands leren</span><span>incompany</span><span>op locatie</span><span>op de werkvloer</span><span>NT2-docent</span>
      </div>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn primary" href="/contact/">Plan een kennismaking</a>
        <a class="btn ghost" href="/offerte-aanvragen/">Offerte aanvragen</a>
      </div>
    </div>

    <section class="alt">
      <div class="container">
        <h2 style="text-align:center;">Wat levert het op</h2>
        <div class="grid-4" style="margin-top:1.4rem;">
          <div class="benefit">
            <div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4-7-10V5l7-3 7 3v6c0 6-7 10-7 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <h3>Vertrouwen op de vloer</h3>
            <p>Instructies die in één keer goed begrepen worden — geen giswerk meer.</p>
          </div>
          <div class="benefit">
            <div class="blob-icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="10" r="5"/><circle cx="16" cy="13" r="4"/></svg></div>
            <h3>Samen sterker</h3>
            <p>Collega's die elkaar eindelijk helemaal verstaan, ook tussendoor.</p>
          </div>
          <div class="benefit">
            <div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M12 21V9"/><path d="M12 9c0-4 3-6 6-6-1 4-2 6-6 6z"/><path d="M12 13c0-3-2-5-5-5 1 3 2 5 5 5z"/></svg></div>
            <h3>Merkbare groei</h3>
            <p>Zelfvertrouwen dat je ziet, week na week — geen droge theorie.</p>
          </div>
          <div class="benefit">
            <div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-6h6v6"/><path d="M15 11l3 3"/></svg></div>
            <h3>Warm onthaal</h3>
            <p>Nieuwe collega's die zich sneller onderdeel van het team voelen.</p>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container why-box">
        <div class="blob-icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-4 3-7 7-7s7 3 7 7"/><path d="M15 12l3 3 5-6"/></svg></div>
        <h2>Eén vaste NT2-docent, het hele traject</h2>
        <p class="lead">Ik ben er van de eerste kennismaking tot het laatste compliment op de werkvloer — geen wisselende docenten, geen nieuwe uitleg steeds opnieuw.</p>
        <ul class="practical" style="margin-top:1rem;">
          <li>Eén vaste, gecertificeerde NT2-docent</li>
          <li>Persoonlijk contact, korte lijnen</li>
          <li>Lesplan dat meegroeit met de voortgang van je team</li>
        </ul>
      </div>
    </section>

    <section class="alt">
      <div class="container">
        <h2>In elke branche een andere taal nodig</h2>
        <p>Van de bouwplaats tot de zorg — ik stem elke les af op de woorden die uw team dagelijks nodig heeft.</p>
        <div class="tags">
          <span class="tag">Techniek &amp; installatie</span><span class="tag">Logistiek &amp; transport</span><span class="tag">Productie &amp; industrie</span><span class="tag">Zorg &amp; welzijn</span><span class="tag">Bouw &amp; infra</span><span class="tag">Horeca &amp; facilitair</span><span class="tag">Agrarisch</span><span class="tag">Schoonmaak</span>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <h2 style="text-align:center;">Zo werkt het</h2>
        <div class="steps" style="margin-top:1.4rem;">
          <div class="step">
            <div class="icon-wrap"><div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div><span class="badge">1</span></div>
            <h3>Kennismaking</h3><p>Een gesprek over niveau, werksituatie en waar u naartoe wilt.</p>
          </div>
          <div class="step">
            <div class="icon-wrap"><div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div><span class="badge">2</span></div>
            <h3>Lesplan op maat</h3><p>Een aanpak die past bij de werkplek, de functie en de branche.</p>
          </div>
          <div class="step">
            <div class="icon-wrap"><div class="blob-icon"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div><span class="badge">3</span></div>
            <h3>Les op de werkvloer</h3><p>Wekelijks, dichtbij — op kantoor, in de hal of op de werkplek.</p>
          </div>
          <div class="step">
            <div class="icon-wrap"><div class="blob-icon"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 17.01"/></svg></div><span class="badge">4</span></div>
            <h3>Groei die u ziet</h3><p>Vaste terugkoppeling, zodat de vooruitgang zichtbaar blijft.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="container">
        <h2>Praktische informatie</h2>
        <ul class="practical" style="margin-top:1rem;">
          <li>Groepsles: 4–12 deelnemers</li><li>Individuele les mogelijk</li><li>Op locatie – werkvloer, kantine of kantoor</li><li>Flexibele lestijden</li><li>Opstart binnen 1–4 weken</li><li>Alle taalniveaus A0–C1</li><li>Friesland &amp; heel Nederland</li><li>Geen vaste methode, wel maatwerk</li>
        </ul>
      </div>
    </section>

    <section>
      <div class="container" style="max-width:600px;text-align:center;">
        <blockquote>"Onze medewerkers communiceren nu veel beter met collega's en begrijpen veiligheidsinstructies zonder hulp. De lessen zijn praktisch en direct toepasbaar op de werkvloer."</blockquote>
        <cite>— HR-manager, productiebedrijf Friesland</cite>
      </div>
    </section>

    <section class="alt">
      <div class="container grid-2">
        <div class="benefit"><h3>Wat leert uw team?</h3><p>Werkoverleg voeren, instructies begrijpen, klantcontact — en de vaktaal die bij hun functie hoort.</p></div>
        <div class="benefit"><h3>Hoe ziet een les eruit?</h3><p>Praktijkgericht, herkenbaar, en meteen te gebruiken op de vloer. Geen droge lesboeken.</p></div>
      </div>
    </section>

    <section>
      <div class="container cta-box">
        <h2>Zullen we kennismaken?</h2>
        <p style="margin-bottom:1.2rem;">Vertel me over uw team, ik denk graag met u mee. Reactie binnen 24 uur.</p>
        <div class="btn-row" style="justify-content:center;">
          <a class="btn primary" href="/contact/">Plan een kennismaking</a>
          <a class="btn ghost" href="/offerte-aanvragen/">Offerte aanvragen</a>
        </div>
      </div>
    </section>

    <section style="padding-top:0;padding-bottom:2.5rem;">
      <div class="container" style="padding-top:1.5rem;border-top:1px solid var(--line);">
        <p class="muted" style="margin-bottom:0.5rem;">Meer informatie:</p>
        <ul class="meer-info-list">
          <li><a href="/nt2-voor-particulieren/">Nederlandse les voor particulieren</a></li>
          <li><a href="/nederlandse-les-friesland/">Nederlandse les in Friesland</a></li>
          <li><a href="/nederlandse-les-nederland/">Nederlandse les in Nederland</a></li>
        </ul>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .pg{ background:#fdf8f2; color:#3d2b1a; font-family:"IBM Plex Sans", system-ui, sans-serif; }
  .pg h1,.pg h2{ font-family:"Fraunces", Georgia, serif; color:#3a2711; font-weight:600; }
  .pg .lead,.pg p{ color:#6d5638; }
  .pg .eyebrow{ font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase; color:#b5651d; display:block; margin-bottom:.6rem;}
  .pg h1{font-size:clamp(1.9rem,3.6vw,2.6rem);line-height:1.15;margin-bottom:1rem;max-width:16ch;}
  .pg h2{font-size:clamp(1.35rem,2.4vw,1.7rem);margin-bottom:.7rem;}
  .pg .lead{font-size:1.05rem;line-height:1.65;margin-bottom:0;max-width:46ch;}
  .pg section{padding:3rem 1.5rem;}
  .pg .container{max-width:860px;margin:0 auto;}
  .pg .alt{background:#fff;}

  .hero{ display:flex; gap:2.6rem; align-items:center; padding:3.4rem 1.5rem 1.6rem; max-width:1060px; margin:0 auto; }
  @media (max-width:820px){ .hero{flex-direction:column; padding-top:2rem;} }
  .hero .txt{flex:1.1;}
  .hero .photo{flex:.9; width:100%; max-width:340px;}
  .blob-shape{ position:relative; width:100%; }
  .blob-shape svg{ display:block; width:100%; height:auto; filter:drop-shadow(0 20px 34px rgba(140,90,30,.32)); }
  .blob-shape img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top center;
    clip-path:url(#heroBlobClip);
    filter:sepia(.22) saturate(1.35) brightness(1.05) hue-rotate(-4deg) contrast(1.02);
  }
  .blob-shape .warm-overlay{ position:absolute; inset:0; clip-path:url(#heroBlobClip);
    background:radial-gradient(120% 100% at 30% 15%, rgba(255,196,120,.26), transparent 60%), linear-gradient(155deg, rgba(181,101,29,.12), rgba(15,108,124,.09));
    mix-blend-mode:multiply;
  }

  .kw-strip{ padding:0 1.5rem 3rem; text-align:center; }
  .kw-strip .kw-tags{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;max-width:640px;margin:0 auto;}
  .kw-tags span{font-size:.74rem;font-weight:700;background:#0f6c7c;color:#fff;padding:.32rem .8rem;border-radius:999px;}

  .btn-row{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:1.4rem;}
  .btn{display:inline-flex;align-items:center;justify-content:center;padding:.85rem 1.5rem;border-radius:999px;font-weight:700;font-size:.95rem;text-decoration:none;border:2px solid transparent;}
  .btn.primary{background:#0f6c7c;color:#fff;}
  .btn.primary:hover{background:#0b5360;}
  .btn.ghost{background:transparent;border-color:#b5651d;color:#b5651d;}
  .btn.ghost:hover{background:rgba(181,101,29,.08);}

  .grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem;}
  .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem;}
  @media (max-width:820px){ .grid-4{grid-template-columns:1fr 1fr;} .grid-2{grid-template-columns:1fr;} }
  .benefit{background:#fffaf3;border:1px solid #f0ddc4;border-radius:20px;padding:1.3rem 1.1rem;box-shadow:0 8px 20px rgba(120,80,40,.07);}
  .blob-icon{width:48px;height:48px;border-radius:62% 38% 45% 55% / 55% 45% 55% 45%;background:#fbe6cc;display:flex;align-items:center;justify-content:center;margin-bottom:.8rem;}
  .blob-icon svg{width:24px;height:24px;stroke:#b5651d;fill:none;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round;}
  .benefit h3{font-size:1rem;margin:0 0 .35rem;font-family:"Fraunces",serif;font-weight:600;color:#3a2711;}
  .benefit p{font-size:.86rem;line-height:1.5;margin:0;color:#7a5a3a;}

  .why-box{background:#fbeee0;border:1px solid #f0ddc4;border-radius:20px;padding:1.9rem;}
  .why-box .blob-icon{background:#f4dcb8;}

  .tags{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1rem;}
  .tag{padding:.5rem 1rem;border-radius:999px;font-size:.85rem;font-weight:600;background:#fbe6cc;color:#8a4c14;}

  .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem;}
  @media (max-width:820px){ .steps{grid-template-columns:1fr 1fr;} }
  .step .icon-wrap{position:relative;width:44px;margin-bottom:.85rem;}
  .step .icon-wrap .blob-icon{width:44px;height:44px;margin-bottom:0;}
  .step .badge{position:absolute;top:-7px;right:-7px;width:21px;height:21px;border-radius:50%;font-size:.68rem;font-weight:800;display:flex;align-items:center;justify-content:center;background:#0f6c7c;color:#fff;border:2px solid #fdf8f2;}
  .step h3{font-size:1.02rem;margin:0 0 .35rem;font-family:"Fraunces",serif;font-weight:600;color:#3a2711;}
  .step p{font-size:.88rem;line-height:1.5;margin:0;color:#7a5a3a;}

  .practical{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:.6rem 1.2rem;}
  @media (max-width:820px){ .practical{grid-template-columns:1fr;} }
  .practical li{font-size:.92rem;padding-left:1.4rem;position:relative;color:#4a341d;}
  .practical li::before{content:"✓";position:absolute;left:0;color:#0f6c7c;font-weight:700;}

  blockquote{margin:0;font-family:"Fraunces",serif;font-style:italic;font-size:1.2rem;line-height:1.6;color:#4a341d;}
  cite{display:block;font-style:normal;font-size:.85rem;margin-top:1rem;color:#b5651d;font-weight:600;font-family:"IBM Plex Sans";}

  .cta-box{border-radius:22px;padding:2.3rem;text-align:center;background:linear-gradient(135deg,#0f6c7c,#0b5360);color:#fff;}
  .cta-box h2{color:#fff;}
  .cta-box p{color:rgba(255,255,255,.85);}
  .cta-box .btn.primary{background:#fff;color:#0b5360;}
  .cta-box .btn.ghost{border-color:rgba(255,255,255,.6);color:#fff;}

  .meer-info-list a{color:#0f6c7c;font-weight:600;font-size:.85rem;text-decoration:none;}
  .meer-info-list a:hover{text-decoration:underline;}
  .meer-info-list li::before{content:'–';font-size:.85rem;line-height:1;}
</style>
